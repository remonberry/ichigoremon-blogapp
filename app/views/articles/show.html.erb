<div class="article">
    <% if @article.eyecatch.attached?%>
        <div class="article_image">
            <%= image_tag @article.eyecatch%>
        </div>
    <% end %>

    <h1 class="article_title"><%= @article.title %></h1>
    
    <div class="article_detail">
        <%= link_to account_path(@article.user) do %>
            <%= image_tag @article.user.avatar_image %>
        <% end %>

        <div>
            <p><%= @article.author_name %></p>
            <p><%= @article.display_created_at %></p>
        </div>

        <% if user_signed_in? && current_user.has_written?(@article) %>
            <div class="article_detail_actions">
                <div class="dropdown">
                    <%= image_tag 'actions.svg', class: 'dropbtn' %>

                    <div class="dropdown-content mini">
                        <%= link_to '編集する', edit_article_path(@article) %>
                        <%= link_to '削除する',article_path(@article),data: {turbo_method: 'delete',turbo_confirm: '本当に削除してもよろしいですか？'} %>
                    </div>
                </div>
            </div>
        <% end %>
    </div>

    <div class="article_content">
        <div class="trix-content">
            <%= raw @article.content.to_s %>
        </div>

<div data-controller="like" data-like-article-id-value="<%= @article.id %>" data-like-has-liked-value="<%= user_signed_in? && current_user.has_liked?(@article) %>">
    <% if user_signed_in? %>
            <div class="article_heart hidden active-heart" data-action="click->like#toggle">
                <%= image_tag 'heart-active.svg' %>
            </div>

            <div class="article_heart hidden inactive-heart" data-action="click->like#toggle">
                <%= image_tag 'heart.svg' %>
            </div>
    <% end %>
</div>

<div class="article">
    <h2>コメント一覧</h2>

    <div
        class="comments-container"
        data-controller="comments"
        data-comments-article-id-value="<%= @article.id %>">
    </div>
</div>

<div class="container" data-controller="comment-form">
    <button
        type="button"
        class="btn-secondary"
        data-comment-form-target="button"
        data-action="click->comment-form#show">
        コメントを追加
        </button>

        <div class="comment-text-area hidden" data-comment-form-target="form">
            <%= form_with model: [@article, Comment.new],
                          data: { action: "submit->comment-form#submit" } do |form| %>
                <%= form.text_area :content, class: "sm" %>
                <%= form.submit "コメントを追加", class: "btn-secondary" %>
            <% end %>
        </div>
</div>