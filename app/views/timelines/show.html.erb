<div class="container">
  <%= render partial: 'commons/tabs' %>

    <% @articles.each do |article| %>
      <%= render partial: 'commons/article', locals: { article: article } %>
    <% end %>

    <%= link_to new_article_path do%>
      <div class="float_btn">
        <i class="fa fa-plus"></i>
      </div>
    <% end %>
</div>