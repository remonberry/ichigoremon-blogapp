<div class="container">
    <% if @comment.errors.any? %>
        <ul>
            <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
    <% end %>

    <%= form_with(model: @comment, url: article_comments_path(@comment.article), local: true) do |f| %>
        <div>
            <%= f.label :content, '内容' %>
        </div>
        <div>
            <%= f.text_area :content %>
        </div>
        <%= f.submit '保存', class: 'btn-primary' %>
    <% end %>
</div>